#!/usr/bin/env bash
# secnpmlly CLI - executable entry point for command-line use
# Installed as ~/.local/bin/secnpmlly (copy)
#
# When sourced (from shell rc), secnpmlly.sh handles shell wrappers.
# When executed (from CLI), this script handles version/update/help.

SECNPMLLY_DIR="${SECNPMLLY_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/secnpmlly}"
REPO_DIR="$SECNPMLLY_DIR/repo"
REPO_URL="https://github.com/nathabonfim59/secnpmlly.git"

# Source colors for pretty output
[ -f "$SECNPMLLY_DIR/colors.sh" ] && source "$SECNPMLLY_DIR/colors.sh"

# ── Shared helpers ─────────────────────────────────────────────

_ver() {
  cat "$SECNPMLLY_DIR/version" 2>/dev/null | tr -d '[:space:]' || echo "unknown"
}

_show_version() {
  printf '%ssecnpmlly %s%s\n' "$(c bold_cyan)" "$(_ver)" "$(c off)"
}

_show_help() {
  _show_version
  echo ""
  echo "Usage: secnpmlly <command>"
  echo ""
  echo "Commands:"
  echo "  version   Show version"
  echo "  status    Show installed wrappers and config"
  echo "  update    Verify and install the latest signed release"
  echo "  help      Show this help"
  echo ""
  echo "To uninstall:"
  echo "  bash $SECNPMLLY_DIR/uninstall.sh"
  echo ""
  echo "Wrappers are loaded by sourcing secnpmlly.sh in your shell rc."
  echo "Managed commands: npm, npx, pnpm, pnpx, yarn, bun, bunx"
}

# ── GPG helpers ────────────────────────────────────────────────

_import_trusted_key() {
  local keyfile="$SECNPMLLY_DIR/keys/trusted.asc"
  [ -f "$keyfile" ] || return 0

  local _fp
  _fp=$(gpg --with-fingerprint --with-colons "$keyfile" 2>/dev/null \
    | grep '^fpr:' | head -1 | cut -d: -f10)
  if [ -n "$_fp" ]; then
    gpg --list-keys --with-colons "$_fp" &>/dev/null && return 0
  fi

  echo ""
  printf '%s--------------------------------------------------------------%s\n' "$(c bold_cyan)" "$(c off)"
  printf '%s  GPG Public Key Import%s\n' "$(c bold_cyan)" "$(c off)"
  printf '%s--------------------------------------------------------------%s\n' "$(c bold_cyan)" "$(c off)"
  echo ""
  echo "  secnpmlly verifies that every update is signed by the maintainer's"
  echo "  GPG key. This protects you from tampered releases."
  echo ""
  echo "  We need to import this public key into your GPG keyring so that"
  echo "  'secnpmlly update' can verify signatures."
  echo ""
  echo "  Key details:"
  gpg --with-fingerprint "$keyfile" 2>/dev/null \
    | grep -E '(pub|uid|sub|Key fingerprint)' \
    | sed 's/^/    /'
  echo ""
  printf '  %sImport this key into your GPG keyring? [Y/n]%s ' "$(c bold_yellow)" "$(c off)"
  read -r _answer </dev/tty
  case "$_answer" in
    n|N|no|No|NO)
      printf '%s[!]%s Key not imported. Update will skip signature verification.\n' "$(c bold_yellow)" "$(c off)"
      ;;
    *)
      gpg --import "$keyfile" 2>/dev/null || true
      printf '%s[+]%s Trusted GPG key imported.\n' "$(c green)" "$(c off)"
      ;;
  esac
}

_trusted_fingerprint() {
  local keyfile="$SECNPMLLY_DIR/keys/trusted.asc"
  if [ ! -f "$keyfile" ]; then
    echo ""
    return 1
  fi
  gpg --with-fingerprint --with-colons "$keyfile" 2>/dev/null \
    | grep '^fpr:' | head -1 | cut -d: -f10
}

# Get the fingerprint of a key embedded in a string (from git show)
_fingerprint_from_text() {
  echo "$1" | gpg --with-fingerprint --with-colons /dev/stdin 2>/dev/null \
    | grep '^fpr:' | head -1 | cut -d: -f10
}

_tag_signer_fp() {
  local tag="$1"
  git -C "$REPO_DIR" tag -v "$tag" 2>&1 \
    | grep 'using RSA key' | head -1 \
    | sed 's/.*using RSA key //' | tr -d '[:space:]'
}

# ── Update command ─────────────────────────────────────────────
#
# Flow:
#   1. Ensure managed repo clone (HTTPS)
#   2. Import trusted key
#   3. git fetch --tags (downloads metadata only, no checkout)
#   4. Find latest tag > current version
#   5. Verify tag signature (GPG)
#   6. Extract key from tag with git show (no checkout)
#      - If key changed -> ABORT, clone to safe tmpdir for review
#   7. git merge --ff-only (now safe to checkout)
#   8. Run apply-protections.sh
#      - On failure -> git checkout HEAD~1 (rollback)
#

_cmd_update() {
  # ── Step 1: Ensure managed repo ─────────────────────────────
  if [ ! -d "$REPO_DIR/.git" ]; then
    printf '%s[i]%s Initial clone to %s ...\n' "$(c cyan)" "$(c off)" "$REPO_DIR"
    mkdir -p "$SECNPMLLY_DIR"
    git clone "$REPO_URL" "$REPO_DIR" 2>&1 || {
      printf '%s[x]%s Failed to clone. Check your connection.\n' "$(c red)" "$(c off)"
      exit 1
    }
  fi

  # Ensure remote is HTTPS
  local _remote
  _remote=$(git -C "$REPO_DIR" remote get-url origin 2>/dev/null || echo "")
  if [ "$_remote" != "$REPO_URL" ]; then
    git -C "$REPO_DIR" remote set-url origin "$REPO_URL"
  fi

  local _old_ver
  _old_ver=$(_ver)

  # ── Step 2: Import trusted key ──────────────────────────────
  _import_trusted_key

  local _old_fp
  _old_fp=$(_trusted_fingerprint)
  if [ -z "$_old_fp" ]; then
    printf '%s[!]%s No trusted public key found. Skipping signature verification.\n' "$(c bold_yellow)" "$(c off)"
  fi

  # ── Step 3: Fetch tags (no checkout) ────────────────────────
  printf '%s[i]%s Fetching latest releases ...\n' "$(c cyan)" "$(c off)"
  git -C "$REPO_DIR" fetch origin --tags 2>&1 || {
    printf '%s[x]%s git fetch failed. Check your connection.\n' "$(c red)" "$(c off)"
    exit 1
  }

  # ── Step 4: Find latest tag newer than current ──────────────
  local _latest_tag
  _latest_tag=$(git -C "$REPO_DIR" tag -l 'v*' --sort=-v:refname | head -1)

  if [ -z "$_latest_tag" ]; then
    printf '%s[!]%s No release tags found.\n' "$(c bold_yellow)" "$(c off)"
    exit 1
  fi

  local _tag_ver
  _tag_ver=$(echo "$_latest_tag" | sed 's/^v//')

  if [ "$_tag_ver" = "$_old_ver" ]; then
    printf '%s[+]%s Already on latest version (%s)\n' "$(c green)" "$(c off)" "$_old_ver"
    exit 0
  fi

  printf '%s[i]%s Found new release: %s -> %s\n' "$(c cyan)" "$(c off)" "$_old_ver" "$_tag_ver"

  # ── Step 5: Verify tag signature ────────────────────────────
  if [ -n "$_old_fp" ]; then
    printf '%s[i]%s Verifying tag signature for %s ...\n' "$(c cyan)" "$(c off)" "$_latest_tag"

    local _signer_fp
    _signer_fp=$(_tag_signer_fp "$_latest_tag")

    if [ -z "$_signer_fp" ]; then
      printf '%s[x]%s Tag %s is NOT signed or verification failed!\n' "$(c red)" "$(c off)" "$_latest_tag"
      printf '%s[x]%s Refusing to install. Possible supply-chain attack.\n' "$(c red)" "$(c off)"
      exit 1
    fi

    # Accept the primary key or any of its subkeys
    local _trusted_fps
    _trusted_fps=$(gpg --with-colons --fingerprint "$_old_fp" 2>/dev/null \
      | grep '^fpr:' | cut -d: -f10)

    if echo "$_trusted_fps" | grep -qF "$_signer_fp"; then
      printf '%s[+]%s Signature verified - key matches trusted fingerprint\n' "$(c green)" "$(c off)"
    else
      printf '%s[x]%s Tag %s was signed by an UNTRUSTED key!\n' "$(c red)" "$(c off)" "$_latest_tag"
      printf '%s    Trusted: %s%s\n' "$(c bold_yellow)" "$_old_fp" "$(c off)"
      printf '%s    Signer:  %s%s\n' "$(c bold_yellow)" "$_signer_fp" "$(c off)"
      printf '%s[x]%s Refusing to install.\n' "$(c red)" "$(c off)"
      exit 1
    fi
  fi

  # ── Step 6: Check key at tag (without checkout) ─────────────
  #    Extract the key file content directly from the tag object.
  #    Working tree is NOT modified.
  local _new_key_text
  _new_key_text=$(git -C "$REPO_DIR" show "$_latest_tag:secnpmlly/keys/trusted.asc" 2>/dev/null || echo "")

  if [ -n "$_old_fp" ] && [ -n "$_new_key_text" ]; then
    local _new_fp
    _new_fp=$(_fingerprint_from_text "$_new_key_text")

    if [ -n "$_new_fp" ] && [ "$_old_fp" != "$_new_fp" ]; then
      echo ""
      printf '%s**************************************************************%s\n' "$(c bold_red)" "$(c off)"
      printf '%s*                                                            *%s\n' "$(c bold_red)" "$(c off)"
      printf '%s*  WARNING: PUBLIC KEY HAS CHANGED - POSSIBLE COMPROMISE     *%s\n' "$(c bold_red)" "$(c off)"
      printf '%s*                                                            *%s\n' "$(c bold_red)" "$(c off)"
      printf '%s**************************************************************%s\n' "$(c bold_red)" "$(c off)"
      echo ""
      printf '  %sOld fingerprint: %s%s\n' "$(c bold_yellow)" "$_old_fp" "$(c off)"
      printf '  %sNew fingerprint: %s%s\n' "$(c bold_yellow)" "$_new_fp" "$(c off)"
      echo ""
      echo "  The signing key in the release does not match the one you trusted."
      echo "  This could mean:"
      echo "    - The repository was compromised"
      echo "    - The maintainer rotated keys (check official channels)"
      echo ""
      echo "  No code has been checked out. Your installation is safe."
      echo ""

      # Clone to a safe temp dir for manual review (no execution)
      local _review_dir
      _review_dir=$(mktemp -d "${TMPDIR:-/tmp}/secnpmlly-audit-XXXXXX")

      printf '%s[i]%s Cloning to %s (read-only review) ...\n' "$(c cyan)" "$(c off)" "$_review_dir"
      if git clone --branch "$_latest_tag" --depth 1 "$REPO_URL" "$_review_dir/secnpmlly-review" 2>&1; then
        chmod -R a-x "$_review_dir/secnpmlly-review/" 2>/dev/null || true

        echo ""
        printf '%s[i]%s Review the code at: %s%s\n' "$(c cyan)" "$(c off)" "$_review_dir/secnpmlly-review"
        echo ""
        printf '%s[i]%s Compare keys manually:\n' "$(c cyan)" "$(c off)"
        echo "  diff $SECNPMLLY_DIR/keys/trusted.asc $_review_dir/secnpmlly-review/secnpmlly/keys/trusted.asc"
        echo ""
        echo "  If you trust the new key, run:"
        echo "    gpg --import $_review_dir/secnpmlly-review/secnpmlly/keys/trusted.asc"
        echo "    cp $_review_dir/secnpmlly-review/secnpmlly/keys/trusted.asc $SECNPMLLY_DIR/keys/trusted.asc"
        echo "    secnpmlly update"
      else
        printf '%s[x]%s Clone for review failed.\n' "$(c red)" "$(c off)"
        rm -rf "$_review_dir"
      fi

      echo ""
      printf '%s[!]%s Aborting update. Review and decide manually.\n' "$(c bold_yellow)" "$(c off)"
      exit 1
    fi
  fi

  # ── Step 7: Merge (working tree is updated now) ─────────────
  local _previous_ref
  _previous_ref=$(git -C "$REPO_DIR" rev-parse HEAD)

  printf '%s[i]%s Checking out %s ...\n' "$(c cyan)" "$(c off)" "$_latest_tag"
  git -C "$REPO_DIR" merge --ff-only "$_latest_tag" 2>&1 || {
    printf '%s[x]%s Merge failed. You may have local changes.\n' "$(c red)" "$(c off)"
    printf '%s[x]%s Run: rm -rf %s && secnpmlly update\n' "$(c red)" "$(c off)" "$REPO_DIR"
    exit 1
  }

  # ── Step 8: Install ─────────────────────────────────────────
  #    If installer fails, roll back the working tree immediately.
  if ! bash "$REPO_DIR/apply-protections.sh"; then
    printf '%s[x]%s Installer failed. Rolling back ...\n' "$(c red)" "$(c off)"
    git -C "$REPO_DIR" checkout "$_previous_ref" 2>/dev/null
    exit 1
  fi

  local _new_ver
  _new_ver=$(_ver)
  echo ""
  printf '%s[+]%s Updated %s -> %s\n' "$(c green)" "$(c off)" "$_old_ver" "$_new_ver"
  echo ""
  printf '%sReload your shell to activate any changes.%s\n' "$(c bold_yellow)" "$(c off)"
}

# ── Main ──────────────────────────────────────────────────────

case "${1:-}" in
  version|--version|-v)
    _show_version
    ;;
  status)
    _show_version
    echo ""
    echo "Installed at: $SECNPMLLY_DIR"
    echo "Repo at:      $REPO_DIR"
    echo ""
    echo "Shell wrappers: loaded via rc file source"
    echo "  npm, npx, pnpm, pnpx, yarn, bun, bunx"
    ;;
  update)
    _cmd_update
    ;;
  help|--help|-h|"")
    _show_help
    ;;
  *)
    printf '%s[x]%s Unknown command: %s\n' "$(c red)" "$(c off)" "$1"
    _show_help
    exit 1
    ;;
esac
