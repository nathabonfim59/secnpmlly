#!/usr/bin/env bash
# secnpmlly CLI — executable entry point for command-line use
# Installed as ~/.local/bin/secnpmlly (symlink or copy)
#
# When sourced (from shell rc), secnpmlly.sh handles shell wrappers.
# When executed (from CLI), this script handles version/update/help.

SECNPMLLY_DIR="${SECNPMLLY_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/secnpmlly}"

# Source colors for pretty output
[ -f "$SECNPMLLY_DIR/colors.sh" ] && source "$SECNPMLLY_DIR/colors.sh"

# ── Shared helpers ─────────────────────────────────────────────

_ver() {
  cat "$SECNPMLLY_DIR/version" 2>/dev/null | tr -d '[:space:]' || echo "unknown"
}

_show_version() {
  printf '%ssecnpmlly %s%s\n' "$(c bold_cyan)" "$(_ver)" "$(c off)"
}

_show_help() {
  _show_version
  echo ""
  echo "Usage: secnpmlly <command>"
  echo ""
  echo "Commands:"
  echo "  version   Show version"
  echo "  status    Show installed wrappers and config"
  echo "  update    Verify and install the latest signed release"
  echo "  help      Show this help"
  echo ""
  echo "Wrappers are loaded by sourcing secnpmlly.sh in your shell rc."
  echo "Managed commands: npm, npx, pnpm, pnpx, bun, bunx"
}

# ── GPG helpers ────────────────────────────────────────────────

# Import the trusted public key from the repo into the user's keyring.
# Idempotent — safe to call multiple times.
_import_trusted_key() {
  local keyfile="$SECNPMLLY_DIR/keys/trusted.asc"
  if [ -f "$keyfile" ]; then
    gpg --import "$keyfile" 2>/dev/null || true
  fi
}

# Get the fingerprint of the trusted key file currently installed.
_trusted_fingerprint() {
  local keyfile="$SECNPMLLY_DIR/keys/trusted.asc"
  if [ ! -f "$keyfile" ]; then
    echo ""
    return 1
  fi
  gpg --with-fingerprint --with-colons "$keyfile" 2>/dev/null \
    | grep '^fpr:' | head -1 | cut -d: -f10
}

# Get the fingerprint of the key that signed a given tag.
# Returns empty string if verification fails.
_tag_signer_fingerprint() {
  local tag="$1"
  git tag -v "$tag" 2>&1 \
    | grep 'using RSA key' | head -1 \
    | sed 's/.*using RSA key //' | tr -d '[:space:]'
}

# Get the fingerprint from a key file (without importing it).
_keyfile_fingerprint() {
  local keyfile="$1"
  gpg --with-fingerprint --with-colons "$keyfile" 2>/dev/null \
    | grep '^fpr:' | head -1 | cut -d: -f10
}

# ── Update command ─────────────────────────────────────────────

_cmd_update() {
  local _source
  _source=$(cat "$SECNPMLLY_DIR/source" 2>/dev/null || echo "")

  if [ -z "$_source" ] || [ ! -d "$_source/.git" ]; then
    printf '%s[x]%s Source repo not found.\n' "$(c red)" "$(c off)"
    printf '%s[x]%s Clone the repo and run apply-protections.sh first.\n' "$(c red)" "$(c off)"
    exit 1
  fi

  local _old_ver
  _old_ver=$(_ver)

  # ── Step 1: Import trusted key ──────────────────────────────
  _import_trusted_key

  local _old_fp
  _old_fp=$(_trusted_fingerprint)
  if [ -z "$_old_fp" ]; then
    printf '%s[!]%s No trusted public key found. Skipping signature verification.\n' "$(c bold_yellow)" "$(c off)"
  fi

  # ── Step 2: Fetch tags (no merge) ───────────────────────────
  printf '%s[i]%s Fetching latest from remote ...\n' "$(c cyan)" "$(c off)"
  (cd "$_source" && git fetch origin --tags) || {
    printf '%s[x]%s git fetch failed. Check your connection.\n' "$(c red)" "$(c off)"
    exit 1
  }

  # ── Step 3: Find latest tag newer than current ──────────────
  local _latest_tag
  _latest_tag=$(cd "$_source" && git tag -l 'v*' --sort=-v:refname | head -1)

  if [ -z "$_latest_tag" ]; then
    printf '%s[!]%s No signed tags found in the repo.\n' "$(c bold_yellow)" "$(c off)"
    printf '%s[!]%s Ask the maintainer to create a signed release tag.\n' "$(c bold_yellow)" "$(c off)"
    exit 1
  fi

  local _tag_ver
  _tag_ver=$(echo "$_latest_tag" | sed 's/^v//')

  if [ "$_tag_ver" = "$_old_ver" ]; then
    printf '%s[+]%s Already on latest version (%s)\n' "$(c green)" "$(c off)" "$_old_ver"
    exit 0
  fi

  printf '%s[i]%s Found new release: %s -> %s\n' "$(c cyan)" "$(c off)" "$_old_ver" "$_tag_ver"

  # ── Step 4: Check if public key changed ─────────────────────
  local _new_keyfile="$_source/secnpmlly/keys/trusted.asc"
  if [ -n "$_old_fp" ] && [ -f "$_new_keyfile" ]; then
    local _new_fp
    _new_fp=$(_keyfile_fingerprint "$_new_keyfile")

    if [ -n "$_new_fp" ] && [ "$_old_fp" != "$_new_fp" ]; then
      echo ""
      printf '%s╔══════════════════════════════════════════════════════════════╗%s\n' "$(c bold_red)" "$(c off)"
      printf '%s║                                                              ║%s\n' "$(c bold_red)" "$(c off)"
      printf '%s║   ⚠  WARNING: PUBLIC KEY HAS CHANGED — POSSIBLE COMPROMISE  ║%s\n' "$(c bold_red)" "$(c off)"
      printf '%s║                                                              ║%s\n' "$(c bold_red)" "$(c off)"
      printf '%s╚══════════════════════════════════════════════════════════════╝%s\n' "$(c bold_red)" "$(c off)"
      echo ""
      printf '%s  Old fingerprint: %s%s\n' "$(c bold_yellow)" "$_old_fp" "$(c off)"
      printf '%s  New fingerprint: %s%s\n' "$(c bold_yellow)" "$_new_fp" "$(c off)"
      echo ""
      echo "  The signing key in the repo does not match the one you trusted."
      echo "  This could mean:"
      echo "    - The repository was compromised"
      echo "    - The maintainer rotated keys (check official channels)"
      echo ""
      echo "  Cloning to a safe temp directory for manual review (no execution)."
      echo ""

      # Clone to a temp dir — no execution, user reviews manually
      local _tmpdir
      _tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/secnpmlly-audit-XXXXXX")
      chmod 755 "$_tmpdir"

      local _remote
      _remote=$(cd "$_source" && git remote get-url origin)

      printf '%s[i]%s Cloning to %s (read-only review) ...\n' "$(c cyan)" "$(c off)" "$_tmpdir"
      git clone --branch "$_latest_tag" --depth 1 "$_remote" "$_tmpdir/secnpmlly-review" || {
        printf '%s[x]%s Clone failed.\n' "$(c red)" "$(c off)"
        exit 1
      }

      # Strip execution permissions from all files in the review copy
      chmod -R a-x "$_tmpdir/secnpmlly-review/" 2>/dev/null || true

      echo ""
      printf '%s[i]%s Review the code at: %s%s\n' "$(c cyan)" "$(c off)" "$_tmpdir/secnpmlly-review"
      echo ""
      printf '%s[i]%s Compare keys manually:\n' "$(c cyan)" "$(c off)"
      echo "  diff $SECNPMLLY_DIR/keys/trusted.asc $_tmpdir/secnpmlly-review/secnpmlly/keys/trusted.asc"
      echo ""
      echo "  If you trust the new key, run:"
      echo "    gpg --import $_tmpdir/secnpmlly-review/secnpmlly/keys/trusted.asc"
      echo "    cp $_tmpdir/secnpmlly-review/secnpmlly/keys/trusted.asc $SECNPMLLY_DIR/keys/trusted.asc"
      echo "    secnpmlly update"
      echo ""
      printf '%s[!]%s Aborting update. Review and decide manually.%s\n' "$(c bold_yellow)" "$(c off)"
      exit 1
    fi
  fi

  # ── Step 5: Verify tag signature ────────────────────────────
  if [ -n "$_old_fp" ]; then
    printf '%s[i]%s Verifying tag signature for %s ...\n' "$(c cyan)" "$(c off)" "$_latest_tag"

    local _signer_fp
    _signer_fp=$(cd "$_source" && _tag_signer_fingerprint "$_latest_tag")

    if [ -z "$_signer_fp" ]; then
      printf '%s[x]%s Tag %s is NOT signed or verification failed!\n' "$(c red)" "$(c off)" "$_latest_tag"
      printf '%s[x]%s Refusing to install. Possible supply-chain attack.\n' "$(c red)" "$(c off)"
      exit 1
    fi

    # Fuzzy match: GPG may report a subkey or partial fingerprint
    if echo "$_old_fp" | grep -q "$_signer_fp" || echo "$_signer_fp" | grep -q "$_old_fp"; then
      printf '%s[+]%s Signature verified — key matches trusted fingerprint\n' "$(c green)" "$(c off)"
    else
      printf '%s[x]%s Tag %s was signed by an UNTRUSTED key!\n' "$(c red)" "$(c off)" "$_latest_tag"
      printf '%s    Trusted: %s%s\n' "$(c bold_yellow)" "$_old_fp" "$(c off)"
      printf '%s    Signer:  %s%s\n' "$(c bold_yellow)" "$_signer_fp" "$(c off)"
      printf '%s[x]%s Refusing to install.\n' "$(c red)" "$(c off)"
      exit 1
    fi
  fi

  # ── Step 6: Merge and install ───────────────────────────────
  printf '%s[i]%s Checking out %s ...\n' "$(c cyan)" "$(c off)" "$_latest_tag"
  (cd "$_source" && git merge --ff-only "$_latest_tag") || {
    printf '%s[x]%s Merge failed. You may have local changes.\n' "$(c red)" "$(c off)"
    printf '%s[x]%s Resolve manually or re-clone the repo.\n' "$(c red)" "$(c off)"
    exit 1
  }

  if [ -f "$_source/apply-protections.sh" ]; then
    bash "$_source/apply-protections.sh"
  else
    printf '%s[x]%s apply-protections.sh not found in %s\n' "$(c red)" "$(c off)" "$_source"
    exit 1
  fi

  local _new_ver
  _new_ver=$(_ver)
  echo ""
  printf '%s[+]%s Updated %s -> %s\n' "$(c green)" "$(c off)" "$_old_ver" "$_new_ver"
  echo ""
  printf '%sReload your shell to activate any changes.%s\n' "$(c bold_yellow)" "$(c off)"
}

# ── Main ──────────────────────────────────────────────────────

case "${1:-}" in
  version|--version|-v)
    _show_version
    ;;
  status)
    _show_version
    echo ""
    echo "Installed at: $SECNPMLLY_DIR"
    echo ""
    echo "Shell wrappers: loaded via rc file source"
    echo "  npm, npx, pnpm, pnpx, bun, bunx"
    ;;
  update)
    _cmd_update
    ;;
  help|--help|-h|"")
    _show_help
    ;;
  *)
    printf '%s[x]%s Unknown command: %s\n' "$(c red)" "$(c off)" "$1"
    _show_help
    exit 1
    ;;
esac
